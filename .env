# Servidor
PORT=8000
APP_DEBUG=false
# Número de proxies delante de la API (IIS, nginx, balanceador). 0 = ninguno.
TRUST_PROXY=0
# Límite de peticiones por minuto por IP (equivalente a throttle:api de Laravel).
RATE_LIMIT_PER_MINUTE=60

# API Estado de Cuenta TDC - Credicard
CREDICARD_API_CONSULTAR_MESES=
CREDICARD_API_KEY_CONSULTAR_MESES=
CREDICARD_API_MOVIMIENTOS=
CREDICARD_API_KEY_MOVIMIENTOS=
CREDICARD_TIMEOUT=30
CREDICARD_VERIFY_SSL=false
API_EDC_CLIENT_KEY=
